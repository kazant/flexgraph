{
  "name": "@kazant/flexgraph",
  "version": "1.1.0",
  "description": "Flexible relationship graph for the browser: layered layout with strong crossing minimization, ports, orthogonal edge routing with obstacle avoidance, groups and constraints. Plain HTML, CSS & JS.",
  "license": "MIT",
  "author": "Alexander Pettersen (https://github.com/kazant)",
  "homepage": "https://flexgraph-showcase.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazant/flexgraph.git"
  },
  "bugs": {
    "url": "https://github.com/kazant/flexgraph/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kazant"
  },
  "type": "module",
  "main": "./dist/flexgraph.umd.cjs",
  "module": "./dist/flexgraph.esm.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/flexgraph.umd.js",
  "jsdelivr": "./dist/flexgraph.umd.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/flexgraph.esm.js",
      "require": "./dist/flexgraph.umd.cjs"
    },
    "./worker": "./dist/flexgraph.worker.js",
    "./style.css": "./css/graph.css"
  },
  "files": [
    "dist",
    "css",
    "types",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test && npm run build",
    "version": "node scripts/sync-version.mjs && git add src/version.js"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "graph",
    "diagram",
    "layout",
    "erd",
    "flowchart",
    "orthogonal-routing",
    "sugiyama"
  ]
}
